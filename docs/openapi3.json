    "servers": [
        {
            "url": "//localhost:8080/api"
        }
    ],
    "components": {
        "schemas": {
            "model.ConfirmPasswordResetRequest": {
                "type": "object",
                "required": [
                    "password",
                    "passwordConfirm",
                    "token"
                ],
                "properties": {
                    "password": {
                        "type": "string",
                        "minLength": 8
                    },
                    "passwordConfirm": {
                        "type": "string"
                    },
                    "token": {
                        "type": "string"
                    }
                }
            },
            "model.LoginRequest": {
                "type": "object",
                "required": [
                    "identity",
                    "password"
                ],
                "properties": {
                    "identity": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 3
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 8
                    }
                }
            },
            "model.LoginResponse": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "user": {
                        "$ref": "#/components/schemas/model.User"
                    }
                }
            },
            "model.PasswordResetRequest": {
                "type": "object",
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "type": "string"
                    }
                }
            },
            "model.Response": {
                "type": "object",
                "properties": {
                    "data": {},
                    "error": {
                        "type": "string",
                        "example": "Error message"
                    },
                    "message": {
                        "type": "string",
                        "example": "Success message"
                    }
                }
            },
            "model.UpdateUserRequest": {
                "type": "object",
                "properties": {
                    "activityLevel": {
                        "type": "string"
                    },
                    "avatar": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "fitnessGoal": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                }
            },
            "model.User": {
                "type": "object",
                "properties": {
                    "activityLevel": {
                        "type": "string"
                    },
                    "avatar": {
                        "type": "string"
                    },
                    "created": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "emailVisibility": {
                        "type": "boolean"
                    },
                    "fitnessGoal": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "passwordConfirm": {
                        "type": "string"
                    },
                    "updated": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                }
            }
        }
